{
  "name": "dsh-tabby-serial",
  "version": "1.0.4",
  "description": "DeepSeek Harness bundle for the Tabby serial MCP bridge: connects the MCP server and registers the tabby-serial skill, so the agent knows how to reach your serial tabs",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "mcp",
    "serial",
    "tabby",
    "skill",
    "deepseek-harness"
  ],
  "type": "module",
  "main": "./index.js",
  "author": "Wazy-XD",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wazy-XD/tabby-serial-mcp.git",
    "directory": "dsh-bundle"
  },
  "homepage": "https://github.com/Wazy-XD/tabby-serial-mcp#readme",
  "bugs": {
    "url": "https://github.com/Wazy-XD/tabby-serial-mcp/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
